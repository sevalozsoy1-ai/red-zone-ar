{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "corepack": false,
      "node": "20.19.4",
      "pnpm": "10.26.1",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test",
        "EXPO_PUBLIC_API_URL": "https://ar-savas-oyunu.replit.app",
        "ANDROID_QA_TEST_SIGNING": "true"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://ar-savas-oyunu.replit.app"
      }
    }
  }
}
